#!/usr/bin/env bash
# Conventional Commits check for local commits. Enable once with:
#   git config core.hooksPath .githooks
# CI checks pull-request commits with `committed`; this is the local equivalent for
# commits that land straight on main.
set -euo pipefail

subject="$(grep -vE '^\s*(#|$)' "$1" | head -n1 || true)"

# Let git's own generated subjects through.
case "$subject" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9._/-]+\))?!?: .+'
if ! printf '%s' "$subject" | grep -qE "$pattern"; then
  echo "commit-msg: subject must follow Conventional Commits" >&2
  echo "  e.g. 'feat(window): add sliding windows'" >&2
  echo "  got:  $subject" >&2
  exit 1
fi
